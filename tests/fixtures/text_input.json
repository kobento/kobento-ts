        "keyboardType": "text", "capitalization": "words", "contentType": "personName",
        "modifiers": ["fillMaxWidth", { "height": 60 }, { "padding": [10, 16] }] } },
    { "textInput": { "text": "@email", "hint": "Email", "keyboardType": "email", "imeAction": "next",
