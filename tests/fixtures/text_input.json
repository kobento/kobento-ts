      "name": { "type": "string", "value": "", "export": true },
      "email": { "type": "string", "value": "", "export": true },
      "city": { "type": "string", "value": "Paris", "export": true },
      "code": { "type": "string", "value": "", "export": true } } },
  "root": { "column": { "modifiers": ["fillMaxSize", { "background": "#FF000000" }], "children": [
